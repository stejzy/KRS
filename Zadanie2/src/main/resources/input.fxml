<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="linguistic.summary.gui.InputController"
      spacing="10" style="-fx-background-color: bisque;" alignment="TOP_CENTER"
      prefWidth="1200" prefHeight="700">

    <fx:define>
        <ToggleGroup fx:id="summaryTypeGroup"/>
    </fx:define>

    <HBox spacing="10" alignment="CENTER">
        <Label text="Rodzaj podsumowania:"/>
        <RadioButton fx:id="singleSummaryRadio" text="Jednopodmiotowe" toggleGroup="$summaryTypeGroup" selected="true"/>
        <RadioButton fx:id="multiSummaryRadio" text="Wielopodmiotowe" toggleGroup="$summaryTypeGroup"/>
    </HBox>

    <Label fx:id="formLabel" text="Wybierz forme podsumowania" style="-fx-font-weight: bold; -fx-padding: 5 0 5 0;"/>

    <fx:define>
        <ToggleGroup fx:id="chooseForm"/>
    </fx:define>

    <HBox fx:id="formButtonsBox" spacing="10" alignment="CENTER">
        <RadioButton fx:id="form1" text="Forma 1" toggleGroup="$chooseForm"/>
        <RadioButton fx:id="form2" text="Forma 2" toggleGroup="$chooseForm"/>
        <!-- CheckBoxy dla wielopodmiotowych, domyślnie ukryte -->
        <CheckBox fx:id="form1Check" text="Forma 1" visible="false" managed="false"/>
        <CheckBox fx:id="form2Check" text="Forma 2" visible="false" managed="false"/>
        <CheckBox fx:id="form3Check" text="Forma 3" visible="false" managed="false"/>
        <CheckBox fx:id="form4Check" text="Forma 4" visible="false" managed="false"/>
    </HBox>

    <TitledPane fx:id="summarizerPane" text="Wybierz sumaryzatory" expanded="false">
        <content>
            <ScrollPane fitToWidth="true" maxHeight="500">
                <content>
                    <VBox fx:id="radioGroupsContainer" spacing="20">
                        <padding>
                            <Insets bottom="10" right="10" left="10"/>
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </content>
    </TitledPane>

    <TitledPane fx:id="quantifierPane" text="Wybierz kwantyfikatory" expanded="false">
        <content>
            <ScrollPane fitToWidth="true" maxHeight="500">
                <content>
                    <VBox fx:id="quantifierContainer" spacing="20">
                        <padding>
                            <Insets bottom="10" right="10" left="10"/>
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </content>
    </TitledPane>

    <TitledPane fx:id="qualityMeasuresPane" text="Wybierz miary jakości" expanded="false">
        <content>
            <ScrollPane fitToWidth="true" maxHeight="500">
                <content>
                    <VBox fx:id="qualityMeasuresContainer" spacing="20">
                        <padding>
                            <Insets bottom="10" right="10" left="10"/>
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </content>
    </TitledPane>

    <VBox fx:id="weightsContainer" spacing="10" alignment="CENTER" visible="false" managed="false">
        <Label text="Wagi dla Optimal Summary:"/>
        <HBox spacing="10" alignment="CENTER">
            <TextField fx:id="weight1" promptText="Waga 1" prefWidth="60"/>
            <TextField fx:id="weight2" promptText="Waga 2" prefWidth="60"/>
            <TextField fx:id="weight3" promptText="Waga 3" prefWidth="60"/>
            <TextField fx:id="weight4" promptText="Waga 4" prefWidth="60"/>
            <TextField fx:id="weight5" promptText="Waga 5" prefWidth="60"/>
            <TextField fx:id="weight6" promptText="Waga 6" prefWidth="60"/>
            <TextField fx:id="weight7" promptText="Waga 7" prefWidth="60"/>
            <TextField fx:id="weight8" promptText="Waga 8" prefWidth="60"/>
            <TextField fx:id="weight9" promptText="Waga 9" prefWidth="60"/>
            <TextField fx:id="weight10" promptText="Waga 10" prefWidth="60"/>
            <TextField fx:id="weight11" promptText="Waga 11" prefWidth="60"/>
        </HBox>
    </VBox>


    <HBox spacing="10" alignment="CENTER">
        <Label text="Sortuj według miary jakości:"/>
        <ComboBox fx:id="qualitySortComboBox" promptText="Wybierz miarę"/>
    </HBox>

<!--    <Button fx:id="generateButton" text="Generuj podsumowania" style="-fx-font-weight: bold; -fx-padding: 10;" VBox.vgrow="NEVER"/>-->

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="generateButton" text="Generuj podsumowania" style="-fx-font-weight: bold; -fx-padding: 10;" />
        <Button fx:id="saveButton" text="Zapisz do pliku"/>
        <TextField fx:id="rowsToSaveField" promptText="Liczba wierszy" prefWidth="100"/>
    </HBox>

    <TableView fx:id="summaryTable" prefHeight="200" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="summaryCol" text="Podsumowanie"/>
        </columns>
    </TableView>
</VBox>
